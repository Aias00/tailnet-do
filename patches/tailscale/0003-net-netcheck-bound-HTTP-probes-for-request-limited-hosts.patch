diff --git a/net/netcheck/http_probe_limit_test.go b/net/netcheck/http_probe_limit_test.go
new file mode 100644
index 0000000..9d3da4a
--- /dev/null
+++ b/net/netcheck/http_probe_limit_test.go
@@ -0,0 +1,58 @@
+package netcheck
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"tailscale.com/tailcfg"
+)
+
+type limitedProbeTransport struct {
+	requests atomic.Int32
+	closed   atomic.Int32
+}
+
+type limitedProbeBody struct {
+	io.Reader
+	closed *atomic.Int32
+}
+
+func (b limitedProbeBody) Close() error { b.closed.Add(1); return nil }
+
+func (tr *limitedProbeTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	tr.requests.Add(1)
+	return &http.Response{StatusCode: 200, Body: limitedProbeBody{strings.NewReader(""), &tr.closed}}, nil
+}
+
+func TestHTTPProbeLimit(t *testing.T) {
+	oldLimit, oldClient := HTTPProbeLimit, http.DefaultClient
+	t.Cleanup(func() { HTTPProbeLimit, http.DefaultClient = oldLimit, oldClient })
+	HTTPProbeLimit = 2
+	tr := new(limitedProbeTransport)
+	http.DefaultClient = &http.Client{Transport: tr}
+	dm := &tailcfg.DERPMap{Regions: map[tailcfg.DERPRegionID]*tailcfg.DERPRegion{}}
+	for i := range 8 {
+		id := tailcfg.DERPRegionID(i + 1)
+		dm.Regions[id] = &tailcfg.DERPRegion{
+			RegionID: id,
+			Nodes:    []*tailcfg.DERPNode{{HostName: fmt.Sprintf("derp%d.example", i+1), RegionID: id}},
+		}
+	}
+	c := &Client{}
+	rs := &reportState{c: c, report: &Report{RegionLatency: map[tailcfg.DERPRegionID]time.Duration{}}}
+	if err := c.runHTTPOnlyChecks(context.Background(), nil, rs, dm); err != nil {
+		t.Fatal(err)
+	}
+	if got := tr.requests.Load(); got != 4 {
+		t.Fatalf("requests = %d, want 4 (two per region)", got)
+	}
+	if got := tr.closed.Load(); got != tr.requests.Load() {
+		t.Fatalf("closed bodies = %d, want %d", got, tr.requests.Load())
+	}
+}
