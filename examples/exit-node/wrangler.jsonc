{
  "name": "exit-do",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
  "durable_objects": { "bindings": [{ "name": "EXIT", "class_name": "ExitNode" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExitNode"] }],
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true }
}
